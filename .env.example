# Copy to .env.local and fill in. Never commit the filled-in file.
#
# Two groups below. The split is not cosmetic: anything prefixed with
# NEXT_PUBLIC_ is inlined into the JavaScript bundle at build time and is
# readable by anyone who opens the site. Everything else stays on the server.

# ---------------------------------------------------------------------------
# Browser-safe. Inlined into the client bundle. Put nothing secret here.
# ---------------------------------------------------------------------------

# Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key. Safe to expose: it is constrained by
# row-level security, not by being kept hidden.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server-only secrets. Never prefix these with NEXT_PUBLIC_, never import them
# into a client component, and never return them in an API response or log.
# ---------------------------------------------------------------------------

# DeepSeek API key. Used only from server code (route handlers / server
# components) once the comparison explanations are built in step 4.
DEEPSEEK_API_KEY=

# Supabase service-role key. Bypasses row-level security entirely.
SUPABASE_SERVICE_ROLE_KEY=
