# Copy to .env.local and fill in. Never commit the filled-in file.
#
# Two groups below. The split is not cosmetic: anything prefixed with
# NEXT_PUBLIC_ is inlined into the JavaScript bundle at build time and is
# readable by anyone who opens the site. Everything else stays on the server.

# ---------------------------------------------------------------------------
# Browser-safe. Inlined into the client bundle. Put nothing secret here.
# ---------------------------------------------------------------------------

# Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key. Safe to expose: it is constrained by
# row-level security, not by being kept hidden.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server-only secrets. Never prefix these with NEXT_PUBLIC_, never import them
# into a client component, and never return them in an API response or log.
# ---------------------------------------------------------------------------

# DeepSeek API key. Used only from server code (route handlers / server
# components) once the comparison explanations are built in step 4.
DEEPSEEK_API_KEY=

# Supabase secret key — the newer `sb_secret_...` format, which replaces the
# legacy service_role JWT. It bypasses row-level security entirely, so it is
# server-only and must never be given a NEXT_PUBLIC_ prefix.
#
# Do not use the publishable key (`sb_publishable_...`) here. It is a valid key,
# so nothing would fail loudly — but it does not bypass RLS, and since the
# orders tables carry no policies every read would come back empty.
SUPABASE_SECRET_KEY=

# Legacy name for the same thing, still accepted so existing deployments keep
# working. SUPABASE_SECRET_KEY wins if both are set.
SUPABASE_SERVICE_ROLE_KEY=

# Master switch for paid DeepSeek requests. Anything other than the exact value
# "enabled" keeps live requests off, which is the default. The storefront and
# the comparison table work regardless; only the guidance panel is affected.
AI_LIVE_REQUESTS=

# Salt for the rate-limiting visitor hash. Set any long random string. Without
# it a default is used, which still works but is guessable across deployments.
# No IP or user agent is ever stored — only the salted digest.
AI_VISITOR_SALT=

# Bright Data Web Scraper API token, for the one-off catalog import only
# (scripts/catalog-import.mjs -> /api/admin/catalog/import). Server-only. Not
# needed by the running storefront, so do not set it in Vercel.
BRIGHT_DATA_API_TOKEN=

# Must be the Amazon products "discover by keyword" dataset. The import refuses
# to send anything if this names a different dataset.
BRIGHT_DATA_DATASET_ID=gd_l7q7dkf244hwjntr0

# Enables the protected import route. At least 32 random characters, e.g.
#   openssl rand -hex 32
# Leave unset in Vercel: without it the route answers 404. Production builds
# also need CATALOG_IMPORT_ALLOW_PRODUCTION=true, which should stay unset.
CATALOG_IMPORT_SECRET=
